{
    "_comment": "Configuration file for the ATC Project Explorer UI.",
    "_version": "1.0",
    "TemporaryJSONFileDirectoryName": "_temp_output_JSON_file",
    "TemporaryConsolidatedJSONFileName": "_temp_consolidated_metadata.json",
    "ExportPlotDirectoryName": "Exported_Plots",
    "DefaultSavedJSONFileName": "Consolidated_ATC_Metadata.json",
    "MinifyExportedJSON": false,
    "ATCProjectDirectoryConfig": {
        "_comment": "Configuration for parsing ATC project directories. File names in the validation list must be in the ATC project root directory to begin parsing.",
        "ProjectRootDirectories": {
            "DirectoriesToExclude": []
        },
        "ProjectSubDirectories": {
            "DirectoriesToExclude": [
                "AutoFocus"
            ]
        },
        "ParseProjectRootFiles": [
            {
                "Name": "ProjectData.dat",
                "Parse": true
            },
            {
                "Name": "Statistics.txt",
                "Parse": true
            }
        ],
        "ValidationFiles": [
            "ProjectData.dat",
            "Statistics.txt"
        ]
    },
    "ConsolidatedMetadataConfig": {
        "_comment": "Configuration for consolidating ATC metadata into a single JSON file.",
        "ProjectData": {},
        "Sites": [
            {
                "SiteName": null,
                "RelativeSiteDirectoryPath": null,
                "SiteProjectData": {},
                "Statistics": {
                    "Activities": [
                        {
                            "ActivityName": null,
                            "Duration": null
                        }
                    ]
                },
                "ImageDirectories": [
                    {
                        "DirectoryName": null,
                        "RelativeDirectoryPath": null,
                        "RelativeImagePaths": []
                    }
                ]
            }
        ]
    }
}